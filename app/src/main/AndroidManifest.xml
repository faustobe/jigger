<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".JiggerApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Jigger">

        <activity
            android:name=".ui.shift.ShiftActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Jigger">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.shift.ShiftSummaryActivity"
            android:exported="false"
            android:label="@string/shift_summary"
            android:theme="@style/Theme.Jigger" />

        <activity
            android:name=".ui.inventory.InventoryActivity"
            android:exported="false"
            android:label="@string/inventory"
            android:theme="@style/Theme.Jigger" />

        <activity
            android:name=".ui.history.HistoryActivity"
            android:exported="false"
            android:label="@string/history"
            android:theme="@style/Theme.Jigger" />

    </application>

</manifest>
